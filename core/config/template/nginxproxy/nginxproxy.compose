services:
  nginx-proxy-manager:
    image: 'jc21/nginx-proxy-manager:latest'
    restart: unless-stopped
    ports:
      - '#NPM_HTTP_PORT#:80'
      - '#NPM_HTTPS_PORT#:443'
      - '#NPM_ADMIN_PORT#:81'
    environment:
      TZ: '#TZ#'
      DISABLE_IPV6: 'true'
    volumes:
      - ./data:/data
      - ./letsencrypt:/etc/letsencrypt